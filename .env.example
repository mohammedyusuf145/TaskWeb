# ─── Browser (safe to expose: protected by Row Level Security) ───────────────
# Leave both empty to run Mizan in local demo mode (no account, data stays in this browser).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Web push (reminders when the app is closed). Public half of the VAPID key pair.
# Generate a pair with: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=

# ─── Edge Function secrets (NEVER prefix with VITE_, never commit) ─────────
# Set with: supabase secrets set ANTHROPIC_API_KEY=... TUTOR_MODEL=...
# ANTHROPIC_API_KEY=
# TUTOR_MODEL=claude-sonnet-5-5
# TUTOR_MODEL_LIGHT=claude-haiku-5-5
# TUTOR_DAILY_MESSAGE_CAP=60
# TUTOR_DAILY_TOKEN_CAP=150000
# VAPID_PUBLIC_KEY=        (same value as VITE_VAPID_PUBLIC_KEY)
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
# CRON_SECRET=             (long random string; also stored in the database vault by supabase/cron/schedule-reminders.sql)
# ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:5173
# Optional: point the tutor at a different URL (e.g. a local function)
# VITE_TUTOR_URL=http://localhost:54321/functions/v1/tutor
